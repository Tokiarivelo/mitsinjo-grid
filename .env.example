# Mitsinjo Grid — every env var the project uses. Copy to `.env` (root) and fill in.
# Never put real values here. Keep in sync with apps/web/src/lib/env.ts and .mcp.json
# (rule: .claude/rules/maintenance.md).

# ── Web server ────────────────────────────
# Port for `make dev` / `pnpm dev` / `pnpm start`, Playwright and `make shots`.
# Read by apps/web/scripts/port.mjs (shell PORT wins over this file). Default 3000.
PORT=3001

# ── Copilot LLM (web app, server-only) ────────
# `make env` copies this file to apps/web/.env.local. Production values live in Vercel (Production env), not here.
# meta | mock (mock = offline, no key needed)
LLM_PROVIDER=mock
# Key: dev.meta.ai (Meta Model API). Empty → automatic mock fallback.
META_API_KEY=
# Default muse-spark-1.3 (standard mode: inputs not used for training). Alt: muse-spark-1.2.
# Avoid *-contributor ids (inputs may train Meta models).
META_MODEL=muse-spark-1.3
# Default https://api.meta.ai/v1
META_BASE_URL=

# ── Stitch MCP (Claude Code tooling, not the app) ──
# Read by .mcp.json from the shell environment. `make claude` exports it from .env;
# to export it in a terminal: `source scripts/env.sh` or `eval "$(make -s env-export)"`.
# Key: stitch.withgoogle.com → profile → Stitch settings → API key.
STITCH_API_KEY=


VERCEL_OIDC_TOKEN=
